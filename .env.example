# .env.example · personapi-dotnet
# Plantilla sin credenciales reales. Copiar a .env (ignorado por Git) y
# ajustar valores locales. .env NO se versiona.
#
# Preferencia del proyecto: la cadena de conexión se resuelve por
# configuración de ASP.NET Core (appsettings, User Secrets o variables de
# entorno). Este archivo documenta los nombres esperados; no duplica
# appsettings.json.
#
# Convención de ASP.NET Core: la variable
#   ConnectionStrings__PersonaDb
# sobrescribe ConnectionStrings:PersonaDb.

# Entorno de ejecución: Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development

# URLs de escucha de Kestrel (ajustar a los puertos libres de la máquina)
ASPNETCORE_URLS=http://localhost:5080

# Conexión a SQL Server 2025 Express · base persona_db
# Autenticación integrada de Windows (recomendada en el laboratorio):
ConnectionStrings__PersonaDb=Server=localhost\SQLEXPRESS;Database=persona_db;Trusted_Connection=True;TrustServerCertificate=True

# Autenticación SQL: NO escribir la contraseña aquí ni en appsettings.json.
# Usar User Secrets en desarrollo:
#   dotnet user-secrets set "ConnectionStrings:PersonaDb" "<cadena con credenciales>"

# Despliegue con Docker Compose (docker-compose.yml): contraseña del usuario sa
# del contenedor de SQL Server. Solo en .env, nunca en un archivo versionado.
# Debe tener al menos 8 caracteres e incluir tres de estos cuatro grupos:
# mayúsculas, minúsculas, dígitos y símbolos.
SA_PASSWORD=
