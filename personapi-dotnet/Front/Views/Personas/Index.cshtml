@model PersonaListadoViewModel
@{
    ViewData["Title"] = "Personas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Personas</h1>
    <a asp-action="Create" class="btn btn-primary">Nueva persona</a>
</div>

<partial name="_MensajesServicio" />

@if (Model.EstaVacio)
{
    <div class="alert alert-info" role="status" data-mensaje="vacio">
        Todavía no hay personas registradas. Use <strong>Nueva persona</strong> para crear la primera.
    </div>
}
else
{
    <table class="table table-striped align-middle" data-tabla="personas">
        <thead>
            <tr>
                <th scope="col">Cédula</th>
                <th scope="col">Nombre</th>
                <th scope="col">Apellido</th>
                <th scope="col">Género</th>
                <th scope="col">Edad</th>
                <th scope="col" class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var persona in Model.Personas)
            {
                <tr>
                    <td>@persona.Cc</td>
                    <td>@persona.Nombre</td>
                    <td>@persona.Apellido</td>
                    <td>@persona.GeneroTexto</td>
                    <td>@persona.EdadTexto</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@persona.Cc" class="btn btn-sm btn-outline-secondary">Ver</a>
                        <a asp-action="Edit" asp-route-id="@persona.Cc" class="btn btn-sm btn-outline-secondary">Editar</a>
                        <a asp-action="Delete" asp-route-id="@persona.Cc" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <p class="text-muted small">@Model.Personas.Count persona(s) en <code>persona_db</code>.</p>
}
