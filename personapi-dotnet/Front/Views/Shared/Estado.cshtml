@model EstadoViewModel
@{
    ViewData["Title"] = Model.Titulo;
}

<div class="py-4">
    <p class="text-muted mb-1">Código @Model.Codigo</p>
    <h1 class="h3">@Model.Titulo</h1>
    <p class="lead" data-mensaje="estado">@Model.Mensaje</p>
    <a class="btn btn-outline-primary" asp-controller="Home" asp-action="Index">Volver al inicio</a>
</div>
