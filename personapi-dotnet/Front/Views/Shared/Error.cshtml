@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger h3">Se produjo un error.</h1>
<p>No se pudo procesar la solicitud. El detalle queda registrado en el servidor y no se muestra aquí.</p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Identificador de la solicitud:</strong> <code>@Model.RequestId</code>
    </p>
}

<a class="btn btn-outline-primary" asp-controller="Home" asp-action="Index">Volver al inicio</a>
