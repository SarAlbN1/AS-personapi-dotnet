@model ProfesionViewModel
@* Datos de solo lectura de una profesión; lo comparten Details y Delete. *@
<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Id)</dt>
    <dd class="col-sm-9">@Model.Id</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Nom)</dt>
    <dd class="col-sm-9">@Model.Nom</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Des)</dt>
    <dd class="col-sm-9" style="white-space: pre-line;">@(string.IsNullOrEmpty(Model.Des) ? "—" : Model.Des)</dd>
</dl>
