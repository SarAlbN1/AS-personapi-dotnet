@model IReadOnlyList<EstudioViewModel>
@{
    ViewData["Title"] = "Estudios";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Estudios</h1>
    <a class="btn btn-primary" asp-action="Create">Nuevo estudio</a>
</div>

<partial name="_MensajesServicio" />

@if (Model.Count == 0)
{
    <p class="text-muted" data-mensaje="vacio">No hay estudios registrados.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th scope="col">Profesión</th>
                <th scope="col">Persona</th>
                <th scope="col">Fecha de grado</th>
                <th scope="col">Universidad</th>
                <th scope="col"><span class="visually-hidden">Acciones</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var estudio in Model)
            {
                <tr data-estudio="@estudio.IdProf/@estudio.CcPer">
                    <td>@estudio.IdProf · @estudio.NomProfesion</td>
                    <td>@estudio.CcPer · @estudio.NombrePersona</td>
                    <td>@(estudio.Fecha?.ToString("yyyy-MM-dd") ?? "—")</td>
                    <td>@(string.IsNullOrEmpty(estudio.Univer) ? "—" : estudio.Univer)</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-outline-secondary btn-sm" asp-action="Details" asp-route-idProf="@estudio.IdProf" asp-route-ccPer="@estudio.CcPer">Ver</a>
                        <a class="btn btn-outline-primary btn-sm" asp-action="Edit" asp-route-idProf="@estudio.IdProf" asp-route-ccPer="@estudio.CcPer">Editar</a>
                        <a class="btn btn-outline-danger btn-sm" asp-action="Delete" asp-route-idProf="@estudio.IdProf" asp-route-ccPer="@estudio.CcPer">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
