<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>personapi_dotnet</RootNamespace>
    <UserSecretsId>f2a2bad8-aff8-4711-a43e-ce575364c212</UserSecretsId>
    <!-- XML de comentarios para los resúmenes, descripciones y ejemplos del documento
         OpenAPI (HU-009). CS1591 se silencia: no todo miembro público necesita comentario. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

  <!-- Microsoft.Data.SqlClient 6.1.7 (dependencia de EF Core SqlServer 10.0.14) arrastra
       System.Security.Cryptography.Pkcs 9.0.11, con vulnerabilidades conocidas (NU1902 y
       NU1903). Se fija la versión parcheada de la misma línea .NET 10. -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <!-- El SDK solo publica por convención lo que cuelga de <proyecto>/wwwroot. Aquí el web
       root es Front/wwwroot, así que se declara como contenido para que dotnet publish lo
       copie; sin esto el publicado queda sin estáticos. -->
  <ItemGroup>
    <Content Include="Front\wwwroot\**" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- El bundle de CSS aislado (<ensamblado>.styles.css) lo genera el SDK y lo publica en
       wwwroot/. El web root es Front/wwwroot, así que se copia allí para que _Layout lo
       encuentre tanto en ejecución como en el publicado. -->
  <!-- En ejecución desde el árbol de fuentes el bundle solo existe en obj/, así que se
       copia al web root en compilación; .gitignore lo excluye del control de versiones. -->
  <Target Name="CopiarBundleCssAisladoAlWebRootEnCompilacion" AfterTargets="BundleScopedCssFiles">
    <Copy SourceFiles="$(_ScopedCssOutputFullPath)"
          DestinationFolder="$(MSBuildProjectDirectory)\Front\wwwroot"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_ScopedCssOutputFullPath)')" />
  </Target>

  <Target Name="CopiarBundleCssAisladoAlWebRoot" AfterTargets="Publish">
    <Copy SourceFiles="$(PublishDir)wwwroot\$(TargetName).styles.css"
          DestinationFolder="$(PublishDir)Front\wwwroot"
          Condition="Exists('$(PublishDir)wwwroot\$(TargetName).styles.css')" />
  </Target>

</Project>
